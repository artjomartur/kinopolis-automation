{
  "name": "kinopolis-automation",
  "compatibility_date": "2024-03-22",
  "main": "_worker.js",
  "assets": {
    "directory": "dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kinopolis-db",
      "database_id": "a1285405-63e4-470e-bf61-b6431cc704fd"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "kinopolis-images"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "compatibility_flags": [

    "nodejs_compat"
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
